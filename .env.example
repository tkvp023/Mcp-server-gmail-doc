# Google OAuth credentials (local dev — file paths)
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_TOKEN_PATH=./token.json

# Google OAuth credentials (cloud deploy — raw JSON)
# GOOGLE_CREDENTIALS_JSON={"installed":{"client_id":"...","client_secret":"...",...}}
# GOOGLE_TOKEN_JSON={"token":"...","refresh_token":"...","client_id":"...",...}

# Transport: "stdio" for local, "streamable-http" for cloud
MCP_TRANSPORT=stdio

# HTTP transport settings (only used when MCP_TRANSPORT=streamable-http)
# PORT=8000        # Railway auto-injects this, do NOT set manually on Railway
# HOST=0.0.0.0

# Logging
LOG_LEVEL=INFO
